{
  "name": "aws-logs-fisher",
  "productName": "AWS Logs Fisher",
  "version": "1.0.0",
  "description": "Desktop app to follow and search CloudWatch logs (live and historical) using the AWS CLI and a SAML session (saml2aws)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "dist": "electron-builder --win portable --publish never",
    "test": "node --test"
  },
  "keywords": [
    "aws",
    "cloudwatch",
    "logs",
    "ecs",
    "lambda",
    "electron",
    "saml2aws"
  ],
  "author": "Gustavo Acuña",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razhe/aws-logs-fisher.git"
  },
  "bugs": {
    "url": "https://github.com/razhe/aws-logs-fisher/issues"
  },
  "homepage": "https://github.com/razhe/aws-logs-fisher#readme",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.22.1"
  },
  "build": {
    "appId": "com.razhe.awslogsfisher",
    "productName": "AWS Logs Fisher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/icon-small.svg"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable",
      "artifactName": "AWS-Logs-Fisher-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
